"Refract"
{
	"$normalmap" "water/tfwater001_normal"
	"$bumpmap" "water/tfwater001_normal"
	"%keywords" "aperture"
	
	$refractamount 0.5
	"$refracttint" "[.74 .89 .98]"
	"$translucent" "1"
	$envmap "env_cubemap"
	"$envmaptint" "[1 1 1]"

	"%compilewater" 1
	"$surfaceprop" "water"

	// This is needed for the proxy which animates the normal map
	"$bumpframe" "0"

	"Proxies"
	{
		"AnimatedTexture"
		{
			"animatedtexturevar" "$normalmap"
			"animatedtextureframenumvar" "$bumpframe"
			"animatedtextureframerate" 30.00
		}

		"TextureScroll"
		{
			"texturescrollvar" "$bumptransform"
			"texturescrollrate" .05
			"texturescrollangle" 45.00
		}
	}
}
